{
  "name": "hearth-and-tap",
  "version": "1.0.0",
  "private": true,
  "description": "Booking service (quotes, availability, bookings) for the Hearth & Tap Agentplace agent. MCP + REST.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/dev.ts",
